# Copy to .env or run npm run setup:local. Never commit .env.
APP_URL=http://localhost:3000
# Optional host loopback port and existing Nginx Proxy Manager Docker network.
WEB_PORT=3000
NPM_NETWORK=npm_proxy
DATABASE_URL=postgresql://studio:CHANGE_ME@localhost:55432/studio?schema=public
TENANT_DB_PASSWORD=CHANGE_ME
TENANT_DATABASE_URL=postgresql://studio_tenant:CHANGE_ME@localhost:55432/studio?schema=public
RLS_REQUIRED=true
POSTGRES_USER=studio
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=studio
REDIS_URL=redis://localhost:56379
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
RENDER_TMP_DIR=./data/render
FFMPEG_PATH=
FFPROBE_PATH=
RENDER_TIMEOUT_MS=900000
WORKER_CONCURRENCY=1
WORKER_HEALTH_PORT=3001
PROVIDER_ALLOWED_HOSTS=api.openai.com,api.dev.runwayml.com,api.elevenlabs.io,api.search.brave.com
# Add AI keys through the authenticated UI; they are encrypted in PostgreSQL.
S3_ENDPOINT=http://localhost:59000
# When running optional MinIO inside Compose, set this to http://minio:9000.
# Keep S3_ENDPOINT reachable by the browser for signed downloads.
S3_INTERNAL_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=studio
S3_ACCESS_KEY=studio
S3_SECRET_KEY=CHANGE_ME
MINIO_ROOT_USER=studio
MINIO_ROOT_PASSWORD=CHANGE_ME
# Optional local S3 profile only. Supply an image available in your registry.
# MinIO community images are no longer guaranteed available; production can use external S3.
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
# OAuth app credentials are configured per studio in the authenticated UI.
# Kết nối nền tảng > Cấu hình ứng dụng. Secrets are encrypted in PostgreSQL.
# These publishing flags remain server-wide operator controls.
TIKTOK_DIRECT_POST_ENABLED=false
PUBLISHING_ENABLED=false
LOG_LEVEL=info
REGISTRATION_ENABLED=true


# Exact operator-approved HTTPS hosts for articles and RSS.
RESEARCH_ALLOWED_HOSTS=
# Configure exact Runway output hosts from official task responses.
GENERATED_MEDIA_ALLOWED_HOSTS=dnznrvs05pmza.cloudfront.net
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
ANALYTICS_ENABLED=true
RENDER_COST_CENTS_PER_MINUTE=0
STORAGE_COST_CENTS_PER_GB_MONTH=0
