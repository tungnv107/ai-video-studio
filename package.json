{
  "name": "ai-video-automation-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx --env-file=.env src/worker/main.ts",
    "worker:production": "tsx src/worker/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:render": "tsx --env-file=.env scripts/render-smoke.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "postinstall": "prisma generate",
    "db:rls": "node --env-file=.env scripts/setup-rls.mjs --write-env",
    "test:render:advanced": "tsx --env-file=.env scripts/render-advanced-smoke.ts",
    "test:load": "tsx --env-file=.env scripts/load-smoke.ts",
    "test:backup": "node --env-file=.env scripts/backup-smoke.mjs",
    "workspace:lifecycle": "tsx --env-file=.env scripts/workspace-lifecycle.ts",
    "test:render:motion": "tsx --env-file=.env scripts/render-motion-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.65.0",
    "cron-parser": "^5.4.0",
    "fast-xml-parser": "^5.12.1",
    "ioredis": "^5.8.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "pino": "^10.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
